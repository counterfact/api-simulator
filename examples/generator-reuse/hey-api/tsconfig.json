{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "#api-models": ["./src/generated/types.gen.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["api/**/*.ts", "src/**/*.ts"]
}
