{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": [],
    "paths": {
      "#api-models": ["./src/generated/sdk/models/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "api/**/*.ts", "typecheck.ts"]
}
