{
  "name": "counterfact-nswag-reuse-example",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "generate:models": "node generate-models.mjs",
    "generate:counterfact": "counterfact --config counterfact.yaml --generate --no-update-check",
    "generate": "npm run generate:models && npm run generate:counterfact",
    "typecheck": "tsc --project tsconfig.json",
    "verify": "npm run generate && npm run typecheck && npm run build:runtime",
    "build:runtime": "tsc --project tsconfig.runtime.json"
  },
  "devDependencies": {
    "counterfact": "file:../../../packages/counterfact",
    "typescript": "5.9.3"
  }
}
