{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@app/api-models": ["./src/generated/schema.ts"]
    }
  },
  "include": ["src/**/*.ts", "api/**/*.ts", "typecheck.ts"],
  "exclude": ["api/.cache"]
}
