{
  "name": "counterfact-openapi-typescript-reuse-example",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:models": "openapi-typescript openapi.yaml --output src/generated/schema.ts",
    "generate:counterfact": "counterfact --config counterfact.yaml",
    "generate": "npm run generate:models && npm run generate:counterfact",
    "typecheck": "tsc --project tsconfig.json",
    "verify": "npm run generate && npm run typecheck && node verify.mjs && npm run build:runtime",
    "build:runtime": "tsc --project tsconfig.runtime.json"
  },
  "devDependencies": {
    "counterfact": "file:../../../packages/counterfact",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
