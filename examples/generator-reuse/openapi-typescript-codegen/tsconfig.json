{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "#sdk-models": ["./src/generated/sdk/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "api/**/*.ts"]
}
