{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "#sdk-models": ["./src/generated/sdk/models.ts"]
    }
  },
  "include": ["src/**/*.ts", "type-tests/**/*.ts"]
}
