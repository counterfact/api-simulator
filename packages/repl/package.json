{
  "name": "@counterfact/repl",
  "version": "0.1.0",
  "description": "Inspect and manipulate a running Counterfact simulator from a Node.js REPL.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "License.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rimraf dist && tsc --build",
    "prepack": "yarn build",
    "test": "node --experimental-vm-modules ../../node_modules/jest-cli/bin/jest.js --config ../../jest.config.js packages/repl/test",
    "test:packed-consumer": "node test/package/repl-consumer-smoke.mjs"
  },
  "dependencies": {
    "@counterfact/client": "0.1.0",
    "@counterfact/runtime": "0.1.0"
  }
}
