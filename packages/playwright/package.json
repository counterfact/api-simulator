{
  "name": "@counterfact/playwright",
  "version": "0.1.0",
  "description": "Worker-isolated Counterfact fixtures for Playwright Test.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "License.md"
  ],
  "sideEffects": false,
  "author": "Patrick McElhaney <pmcelhaney@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/counterfact/api-simulator.git",
    "directory": "packages/playwright"
  },
  "bugs": "https://github.com/counterfact/api-simulator/issues",
  "homepage": "https://counterfact.dev",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pmcelhaney"
  },
  "keywords": [
    "counterfact",
    "playwright",
    "api-mocking",
    "testing"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc --build --force",
    "prepack": "yarn build",
    "test": "playwright test --config test/playwright.config.ts && node --test test/teardown.test.mjs",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json && tsc --noEmit --pretty false -p test/tsconfig.json"
  },
  "dependencies": {
    "counterfact": "^3.2.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.39.0 <2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  }
}
