{
  "name": "@counterfact/runtime",
  "version": "0.4.2",
  "description": "Run Counterfact routes with hot reload, validation, proxying, Koa, or MSW.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./koa": {
      "types": "./dist/koa.d.ts",
      "import": "./dist/koa.js"
    },
    "./msw": {
      "types": "./dist/msw.d.ts",
      "import": "./dist/msw.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "License.md"
  ],
  "sideEffects": false,
  "author": "Patrick McElhaney <pmcelhaney@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/counterfact/api-simulator.git",
    "directory": "packages/runtime"
  },
  "bugs": "https://github.com/counterfact/api-simulator/issues",
  "homepage": "https://counterfact.dev",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pmcelhaney"
  },
  "keywords": [
    "counterfact",
    "openapi",
    "mock-server",
    "api-mocking",
    "koa",
    "msw",
    "typescript",
    "testing"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc --build --force && copyfiles -f \"src/server/*.cjs\" dist/server",
    "prepack": "yarn build",
    "test": "yarn test:native && yarn test:jest",
    "test:jest": "node --experimental-vm-modules ../../node_modules/jest-cli/bin/jest.js --config ../../jest.config.js packages/runtime/test",
    "test:native": "yarn --cwd ../.. build && yarn test:native:run",
    "test:native:coverage": "yarn --cwd ../.. build && node --test --test-timeout=30000 --experimental-test-coverage --test-coverage-lines=77 --test-coverage-functions=80 --test-coverage-branches=90 --test-coverage-include=\"**/dist/server/module-loader.js\" --test-coverage-include=\"**/dist/server/module-generation.js\" \"test-native/*.test.mjs\"",
    "test:native:run": "node --test --test-timeout=30000 \"test-native/*.test.mjs\""
  },
  "dependencies": {
    "@counterfact/openapi": "0.1.7",
    "@counterfact/types": "0.3.0",
    "@hapi/accept": "6.0.3",
    "@types/koa": "3.0.3",
    "@types/koa-bodyparser": "4.3.13",
    "@types/koa-proxy": "1.0.8",
    "ajv": "8.20.0",
    "chokidar": "6.0.0",
    "debug": "4.4.3",
    "js-yaml": "5.5.0",
    "json-schema-faker": "0.6.3",
    "koa": "3.2.1",
    "koa-bodyparser": "4.4.1",
    "koa-proxies": "0.12.6",
    "koa2-swagger-ui": "5.12.0",
    "node-fetch": "3.3.2",
    "precinct": "13.0.1",
    "typescript": "6.0.3"
  }
}
