{
  "name": "counterfact-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "test": "yarn workspace counterfact test",
    "test:boundaries": "node --test scripts/check-package-boundaries.test.mjs",
    "test:client": "yarn workspace @counterfact/client test",
    "test:client-packed": "yarn workspace @counterfact/client test:packed-consumer",
    "test:generator": "yarn workspace @counterfact/generator test",
    "test:generator-packed": "yarn workspace @counterfact/generator test:packed-consumer",
    "test:runtime": "yarn workspace @counterfact/runtime test",
    "test:repl": "yarn workspace @counterfact/repl test",
    "test:repl-packed": "yarn workspace @counterfact/repl test:packed-consumer",
    "test:black-box": "yarn workspace counterfact build && python3 -m pytest test-black-box/ -v",
    "test:packed-consumer": "yarn workspace counterfact test:packed-consumer",
    "test:package-closures": "node scripts/test-package-closures.mjs",
    "test:tsd": "tsd --typings ./packages/types/dist/index.d.ts --files ./packages/types/test/**/*.test-d.ts",
    "build": "yarn workspace counterfact build",
    "typecheck": "tsc --build --noEmit --pretty false",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release": "changeset publish",
    "prepare": "husky install",
    "lint": "eslint . --plugin file-progress --rule 'file-progress/activate: 1' --ignore-pattern dist --ignore-pattern out --ignore-pattern coverage",
    "lint:fix": "eslint --fix . --ignore-pattern dist --ignore-pattern out --ignore-pattern coverage",
    "lint:quickfix": "eslint --fix . eslint --fix demo-ts --rule=\"import/namespace: 0,etc/no-deprecated:0,import/no-cycle:0,no-explicit-type-exports/no-explicit-type-exports:0,import/no-deprecated:0,import/no-self-import:0,import/default:0,import/no-named-as-default:0\" --ignore-pattern dist --ignore-pattern out",
    "go:petstore": "yarn build && yarn counterfact https://petstore3.swagger.io/api/v3/openapi.json out",
    "go:petstore2": "yarn build && yarn counterfact https://petstore.swagger.io/v2/swagger.json out",
    "go:example": "yarn build && node ./packages/counterfact/bin/counterfact.js ./packages/counterfact/test/fixtures/openapi/example.yaml out",
    "go:multiple-apis": "yarn build && node ./packages/counterfact/bin/counterfact.js --config ./packages/counterfact/test/fixtures/config/multiple-apis.yaml",
    "counterfact": "./packages/counterfact/bin/counterfact.js"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.4.1",
    "@swc/core": "1.15.47",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.1",
    "@types/debug": "4.1.13",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/koa": "3.0.3",
    "@types/koa-bodyparser": "4.3.13",
    "@types/koa-proxy": "1.0.8",
    "@types/koa-static": "4.0.4",
    "@types/node": "22",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "copyfiles": "2.4.1",
    "eslint": "10.8.1",
    "eslint-formatter-github-annotations": "0.1.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-etc": "2.0.3",
    "eslint-plugin-file-progress": "4.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.0",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-no-explicit-type-exports": "0.12.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.1.1",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "fs-extra": "11.4.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-retries": "1.0.1",
    "node-mocks-http": "1.18.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "tsd": "0.33.0",
    "typescript": "6.0.3",
    "using-temporary-files": "2.2.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "resolutions": {
    "@typescript-eslint/utils": "^8.58.0"
  }
}
