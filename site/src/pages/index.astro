---
import MainLayout from "../layouts/MainLayout.astro";

const exampleCommand =
  "npx counterfact@latest https://petstore3.swagger.io/api/v3/openapi.json api";

const diagrams = [
  {
    name: "waiting",
    height: 342,
    heading: "The backend isn’t ready",
    caption:
      "Frontend work shouldn’t have to wait for the backend. When an API is unavailable or a feature hasn’t been built yet, developers still need a way to build and test the clients that depend on it.",
    alt: "Web and mobile clients send API requests to an unavailable backend and wait for responses.",
  },
  {
    name: "simulation",
    height: 390,
    heading: "Counterfact implements the contract",
    caption:
      "Give Counterfact an OpenAPI contract, and it provides a working API for your web and mobile clients. Develop against that contract, simulate new functionality, and test errors and edge cases without waiting for the live backend.",
    alt: "Web and mobile clients build and test against Counterfact’s simulated responses. An OpenAPI contract specifies the interface; the backend remains unavailable.",
  },
  {
    name: "proxy",
    height: 389,
    heading: "Mix simulated and real responses",
    caption:
      "Simulate new functionality, errors, and edge cases. Use real services when useful.",
    alt: "Web and mobile clients use the same Counterfact interface. Counterfact simulates responses and proxies selected requests to available real services. The OpenAPI contract specifies the interface.",
  },
];
---

<MainLayout
  title="Counterfact — Build the frontend. Don’t wait for the backend."
  description="Build and test against an API contract with Counterfact. Simulate new functionality, errors, and edge cases, and selectively proxy to real services."
  canonicalPath="/"
>
  <header class="site-header">
    <div class="page-shell header-content">
      <a class="brand" href="/" aria-label="Counterfact home">
        <img src="/counterfact.svg" alt="" width="180" height="31" />
      </a>
      <nav aria-label="Primary navigation">
        <a href="#quick-start">Try it</a>
        <a href="/docs/getting-started">Docs</a>
        <a
          href="https://github.com/counterfact/api-simulator/blob/main/CONTRIBUTING.md"
          >Contribute</a
        >
        <a href="https://github.com/counterfact/api-simulator">GitHub</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero page-shell" aria-labelledby="page-title">
      <p class="eyebrow">Local API simulator</p>
      <h1 id="page-title">Build the frontend. Don’t wait for the backend.</h1>
      <p class="lede">
        Counterfact lets frontend developers work independently of the backend.
        People and agents can build and test against an API contract instead of
        a live API, simulating new functionality, error responses, and edge
        cases. Selectively proxy requests to real services when they are useful.
      </p>
      <div class="actions">
        <a class="button button-primary" href="#quick-start">Try it now</a>
        <a class="button button-secondary" href="/docs/getting-started"
          >Read the docs</a
        >
      </div>
    </section>

    <section
      class="page-shell story-section"
      aria-label="How Counterfact works"
    >
      <ol class="diagram-story">
        {
          diagrams.map((diagram) => (
            <li>
              <figure>
                <figcaption>
                  <h2>{diagram.heading}</h2>
                  <p>{diagram.caption}</p>
                </figcaption>
                <div
                  class="diagram-scroll"
                  role="region"
                  aria-label={`${diagram.heading} diagram`}
                  aria-describedby={`${diagram.name}-diagram-help`}
                  tabindex="0"
                >
                  <img
                    src={`/diagrams/counterfact-${diagram.name}.png`}
                    alt={diagram.alt}
                    width="1000"
                    height={diagram.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <p id={`${diagram.name}-diagram-help`} class="diagram-help">
                  <span>Scroll horizontally on small screens. </span>
                  <a href={`/diagrams/counterfact-${diagram.name}.png`}>
                    Open the full-size diagram
                  </a>
                </p>
              </figure>
            </li>
          ))
        }
      </ol>
      <p class="supporting-text">
        The OpenAPI document describes the interface. Counterfact handles
        requests and returns simulated responses or forwards selected requests
        to a real service.
      </p>
    </section>

    <section
      id="quick-start"
      class="page-shell command-section"
      aria-labelledby="command-heading"
    >
      <h2 id="command-heading">Try it with an example API</h2>
      <div class="command-panel">
        <code id="install-cmd">{exampleCommand}</code>
        <button
          id="copy-btn"
          class="copy-button"
          type="button"
          aria-label="Copy command">Copy</button
        >
      </div>
      <p class="supporting-text">
        Requires Node.js 22 or newer. Run in a new directory. Counterfact
        creates editable routes and generated types in <code>api/</code>, then
        starts a local API at <code>http://localhost:3100</code>.
      </p>
      <p class="supporting-text">
        Try <code>http://localhost:3100/pet/1</code> or open{" "}
        <a href="http://localhost:3100/counterfact/swagger/">Swagger UI</a>.
        Generated sample responses are a starting point; customize the behavior
        your frontend needs.
      </p>
      <p class="supporting-text">
        Use your own OpenAPI document in place of the example URL. For a
        repeatable project or CI workflow, <a
          href="/docs/first-10-minutes#install-a-pinned-version"
          >install a pinned version</a
        >{" "}
        and commit the lockfile.
      </p>
    </section>

    <section class="page-shell more-section" aria-labelledby="more-heading">
      <h2 id="more-heading">Keep going</h2>
      <div class="link-list" aria-label="Counterfact guides">
        <a href="/docs/usage">Guides by task</a>
        <a href="/docs/reference">CLI and API reference</a>
        <a href="/docs/features/routes">Custom responses</a>
        <a href="/docs/patterns/simulate-failures">Errors and edge cases</a>
        <a href="/docs/features/proxy">Selective proxying</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="page-shell footer-content">
      <span>Counterfact</span>
      <a
        href="https://github.com/counterfact/api-simulator/blob/main/CONTRIBUTING.md"
        >Contributing</a
      >
      <a href="https://github.com/counterfact/api-simulator/issues">Issues</a>
      <a
        href="https://github.com/counterfact/api-simulator/blob/main/SECURITY.md"
        >Security</a
      >
      <a href="https://www.npmjs.com/package/counterfact">npm</a>
      <a
        href="https://github.com/counterfact/api-simulator/blob/main/packages/counterfact/CHANGELOG.md"
        >Changelog</a
      >
      <a href="/quality/2026">2026 quality study</a>
      <a
        href="https://github.com/counterfact/api-simulator/blob/main/License.md"
        >MIT · Patrick McElhaney</a
      >
    </div>
  </footer>
</MainLayout>

<style>
  .story-section {
    border-top: 1px solid var(--rule);
    padding-block: 3.5rem;
  }
  .diagram-story {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .diagram-story li + li {
    margin-top: 3rem;
  }
  figure {
    margin: 0;
  }
  figure h2 {
    font-size: clamp(1.35rem, 3.5vw, 1.75rem);
  }
  .diagram-scroll {
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 6px;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }
  .diagram-scroll:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }
  .diagram-scroll img {
    display: block;
    height: auto;
    width: 100%;
  }
  .diagram-help {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }
  .diagram-help span {
    display: none;
  }
  figcaption {
    color: var(--muted);
    margin-bottom: 1rem;
  }
  @media (max-width: 480px) {
    .diagram-scroll img {
      min-width: 1000px;
    }
    .diagram-help span {
      display: inline;
    }
    .story-section {
      padding-block: 2.5rem;
    }
    nav {
      flex-wrap: wrap;
    }
  }
</style>
