{
  "name": "counterfact-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "snapshot:audit": "node scripts/quality-snapshot.mjs",
    "test:audit": "node --test scripts/quality-audit.test.mjs",
    "verify:audit": "node scripts/verify-quality-audit.mjs",
    "preview": "astro preview",
    "check-links": "astro preview --host 127.0.0.1 --port 4399 & SERVER_PID=$!; sleep 5 && linkinator http://127.0.0.1:4399 --recurse --skip 'https://|http://(?!127.0.0.1)' --verbosity error; EXIT=$?; kill $SERVER_PID 2>/dev/null; exit $EXIT"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "astro": "7.2.10"
  },
  "devDependencies": {
    "linkinator": "8.1.0"
  },
  "overrides": {
    "satteri": "0.10.5"
  }
}
